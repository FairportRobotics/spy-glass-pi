[Unit]
Description=Spy Glass FRC vision coprocessor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spyglass
Group=spyglass
SupplementaryGroups=video render
WorkingDirectory=/opt/spy-glass
Environment=SPYGLASS_HOST=0.0.0.0
Environment=SPYGLASS_PORT=5000
Environment=SPYGLASS_SETTINGS=/var/lib/spy-glass/settings.json
ExecStart=/opt/spy-glass/.venv/bin/python -m spyglass
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
